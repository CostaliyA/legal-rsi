,\\\"Linked refs\\\"],\\n            data, W7, size=7.3, hdr_size=7.7, fills=fills, bold_cols=(0,), align_center_cols=(4,))\\n\\nh2(doc, \\\"Critical path to the 6 December 2026 permit expiry\\\", space_before=14)\\nbody(doc, \\\"Sequence the pre-permit gates in this order. Each is a prerequisite to the next permit, and several run in parallel.\\\")\\ncp = [\\n (\\\"Now\\\",\\\"Obtain the certified ordinance and the sealed site plan; re-run the gap analysis against the codified text (P-02, D-01, D-02).\\\"),\\n (\\\"Now\\\",\\\"Confirm the Conservation District stormwater submission date. If 6 March 2025 is unreachable, seek a documented Board extension before the date passes (P-06).\\\"),\\n (\\\"Now\\\",\\\"Commission the wetland delineation and floodplain analysis on the shared survey base (P-10).\\\"),\\n (\\\"Q1 2025\\\",\\\"Resolve the lot-coverage determination and the substation setback dimension. Both may require a layout change, and layout changes take longest (P-03, P-09).\\\"),\\n (\\\"Q1–Q2 2025\\\",\\\"Corrective amendment consolidating the Part 4 gaps and the Part 2 conflicts, including the PILOT escalator if the Board chooses to amend rather than accept Year 16 (P-07, P-13).\\\"),\\n (\\\"2025\\\",\\\"PHMC determination and USFWS/PFBC bog turtle consultation, working to the seasonal survey windows (B-03, B-04).\\\"),\\n (\\\"Before permits\\\",\\\"Glare analysis with mitigation plan; parent guaranty; recorded lease memoranda; decommissioning security instrument with rating evidence; executed and recorded PILOT; agricultural mitigation payment on confirmed acreage; road maintenance agreement and bond (B-14, A-02, A-03, D-02, D-06, B-10, A-24).\\\"),\\n (\\\"March 2026\\\",\\\"Building permit issued — comfortably ahead of the 6 December 2026 expiry and consistent with the stated 1 April 2026 construction start.\\\"),\\n]\\nt = doc.add_table(rows=1, cols=2); t.style='Table Grid'\\nfor i,h in enumerate([\\\"Window\\\",\\\"Gate\\\"]):\\n    c=t.rows[0].cells[i]; shade(c,HDR_BG); wtext(c,h,size=7.8,bold=True,color=RGBColor(0xFF,0xFF,0xFF))\\nfor w_, g in cp:\\n    cells=t.add_row().cells\\n    wtext(cells[0], w_, size=7.4, bold=True); wtext(cells[1], g, size=7.4)\\n    cells[0].vertical_alignment = WD_ALIGN_VERTICAL.TOP\\nset_widths(t,[1.3,8.7]); cell_margins(t)\\n\\n# ============================================================ APPENDIX A\\nnew_section(doc, landscape=True)\\nh1(doc, \\\"Appendix A — Condition-by-condition status index\\\", space_before=0)\\nbody(doc, \\\"The Decision imposes thirty-five numbered conditions. This index maps each condition to the tracked obligation rows in Part 1 and gives its aggregate status. A condition is 'mixed' where some of its limbs are satisfied on the record and others are open or conflicting.\\\")\\n\\nCONDDESC = {\\n 1:(\\\"General compliance with the Site Plan\\\",\\\"A-01\\\"),\\n 2:(\\\"Applicant entity and parent guaranty\\\",\\\"A-02\\\"),\\n 3:(\\\"Lease verification and recording\\\",\\\"A-03\\\"),\\n 4:(\\\"Scope of approval\\\",\\\"A-04, A-22\\\"),\\n 5:(\\\"Panel setbacks (property line, ROW, dwelling)\\\",\\\"A-05a, A-05b, A-05c\\\"),\\n 6:(\\\"Substation and conversion station setbacks\\\",\\\"A-06a, A-06b\\\"),\\n 7:(\\\"Access roads and traffic management plan\\\",\\\"A-18, A-19\\\"),\\n 8:(\\\"Threatened and endangered species consultation\\\",\\\"B-04\\\"),\\n 9:(\\\"Historic resource consultation (PHMC)\\\",\\\"B-03\\\"),\\n 10:(\\\"Final stormwater plan within 90 days\\\",\\\"B-05, B-08\\\"),\\n 11:(\\\"Conservation District approval first\\\",\\\"B-06\\\"),\\n 12:(\\\"BESS setbacks, NFPA 855 and design review\\\",\\\"A-07a, A-07b, C-02\\\"),\\n 13:(\\\"NPDES PAG-02 and E&S plan\\\",\\\"B-07\\\"),\\n 14:(\\\"Maximum panel height\\\",\\\"A-08\\\"),\\n 15:(\\\"Perimeter fencing and wildlife openings\\\",\\\"A-12a, A-13\\\"),\\n 16:(\\\"Vegetative screening buffer\\\",\\\"A-17a, A-17e, A-17f\\\"),\\n 17:(\\\"Lighting standards\\\",\\\"A-20\\\"),\\n 18:(\\\"Noise limit and compliance measurement\\\",\\\"B-13a, E-05\\\"),\\n 19:(\\\"Solar glare analysis\\\",\\\"B-14\\\"),\\n 20:(\\\"FAA determination\\\",\\\"A-21\\\"),\\n 21:(\\\"Decommissioning plan and timetable\\\",\\\"D-01\\\"),\\n 22:(\\\"Decommissioning security\\\",\\\"D-02, D-03\\\"),\\n 23:(\\\"Five-yearly cost estimate updates\\\",\\\"D-04\\\"),\\n 24:(\\\"Decommissioning trigger and abandonment\\\",\\\"D-05\\\"),\\n 25:(\\\"Road maintenance bond\\\",\\\"C-05\\\"),\\n 26:(\\\"Pre- and post-construction road surveys\\\",\\\"A-23\\\"),\\n 27:(\\\"Construction traffic plan and hours\\\",\\\"A-19, C-06\\\"),\\n 28:(\\\"Agricultural mitigation payment\\\",\\\"B-10\\\"),\\n 29:(\\\"School district taxes\\\",\\\"D-07\\\"),\\n 30:(\\\"PILOT agreement\\\",\\\"D-06\\\"),\\n 31:(\\\"Maintenance obligations\\\",\\\"E-01\\\"),\\n 32:(\\\"Annual compliance report\\\",\\\"E-02\\\"),\\n 33:(\\\"Emergency response plan and exercises\\\",\\\"C-03, E-07\\\"),\\n 34:(\\\"Timing of financial assurances\\\",\\\"D-08\\\"),\\n 35:(\\\"Modification and amendment\\\",\\\"F-05\\\"),\\n}\\nSTATUS_BY_ID = {r['id']: r['status'] for r in CM.MATRIX}\\nrows_a = []\\nfor n in range(1, 36):\\n    title, ids = CONDDESC[n]\\n    idlist = [x.strip() for x in ids.split(\\\",\\\")]\\n    sts = [STATUS_BY_ID.get(i, \\\"n/a\\\") for i in idlist]\\n    uniq = set(sts)\\n    if uniq == {\\\"Satisfied (record)\\\"}: agg = \\\"Satisfied (record)\\\"\\n    elif any(s in (\\\"Conflict\\\",) for s in uniq): agg = \\\"Conflict\\\"\\n    elif any(s == \\\"Gap\\\" for s in uniq): agg = \\\"Gap\\\"\\n    elif \\\"Open (time-critical)\\\" in uniq: agg = \\\"Open (time-critical)\\\"\\n    elif len(uniq) > 1: agg = \\\"Mixed\\\"\\n    else: agg = sts[0]\\n    rows_a.append([f\\\"Cond {n}\\\", title, ids, agg])\\nfills = {(i,3): STATUS_FILL.get(r[3], \\\"FFE9C2\\\") for i,r in enumerate(rows_a)}\\nbuild_table(doc, [\\\"Condition\\\",\\\"Subject\\\",\\\"Tracked in Part 1\\\",\\\"Aggregate status\\\"],\\n            rows_a, [1.15, 4.6, 2.7, 1.55], size=7.5, hdr_size=7.8,\\n            fills=fills, bold_cols=(0,), align_center_cols=(3,))\\n\\n# ============================================================ APPENDIX B (portrait)\\nnew_section(doc, landscape=False)\\nh1(doc, \\\"Appendix B — Defined terms and abbreviations\\\", space_before=0)\\nterms = [\\n (\\\"BESS\\\",\\\"Battery energy storage system; here 40 MW / 160 MWh lithium-ion, proposed as an accessory use.\\\"),\\n (\\\"COD\\\",\\\"Commercial Operation Date — the date the facility first delivers energy for commercial sale, as certified by the operator and confirmed by the RTO. Projected 31 December 2027 (D&O s.II).\\\"),\\n (\\\"Condition / Cond\\\",\\\"A numbered condition of approval in Section VI of the Decision and Order (1 to 35).\\\"),\\n (\\\"Conservation District\\\",\\\"Lancaster County Conservation District — approves the E&S plan and reviews the stormwater plan before the Township Engineer may accept it (Condition 11).\\\"),\\n (\\\"CU approval\\\",\\\"Conditional use approval granted under s.27-605(B)(14).\\\"),\\n (\\\"D&O\\\",\\\"Decision and Order of the Board of Supervisors dated 6 December 2024.\\\"),\\n (\\\"Engineer / Township Engineer\\\",\\\"Gregory Shultz, P.E., Fieldstone Engineering Associates.\\\"),\\n (\\\"Gen-tie line\\\",\\\"Generation tie line — the 2.3-mile, 138 kV line from the on-site substation to the Conestoga Substation. Outside the project site by definition (s.(a)) and not approved by the CU approval (s.(k)(2)).\\\"),\\n (\\\"Gap (G-)\\\",\\\"A requirement of the Ordinance that the Decision does not carry into its conditions. See Part 4.\\\"),\\n (\\\"Inconsistency (I-)\\\",\\\"A conflict between two reviewed documents. See Part 2.\\\"),\\n (\\\"MFN\\\",\\\"Most-favoured-nation clause — the Township's requested PILOT adjustment mechanism, currently rejected by the applicant.\\\"),\\n (\\\"MPC\\\",\\\"Pennsylvania Municipalities Planning Code, Act of 1967, P.L. 805, 53 P.S. ss.10101 et seq.\\\"),\\n (\\\"NRCS\\\",\\\"United States Department of Agriculture Natural Resources Conservation Service — source of the prime farmland soils classification.\\\"),\\n (\\\"PHMC\\\",\\\"Pennsylvania Historical and Museum Commission.\\\"),\\n (\\\"PILOT\\\",\\\"Payment in lieu of taxes — 385,000 dollars per year for Years 1–15 with a 2% annual escalator thereafter (Conditions 17 and 30).\\\"),\\n (\\\"PNDI\\\",\\\"Pennsylvania Natural Diversity Inventory.\\\"),\\n (\\\"Project Site\\\",\\\"The seven parcels comprising approximately 850 acres, as defined in s.(a) and delimited by Condition 4.\\\"),\\n (\\\"RTO\\\",\\\"Regional transmission organisation. The documents name 'Mid-Atlantic Grid Coordination LLC'; queue position AG2-2024-0847.\\\"),\\n (\\\"Solicitor / Township Solicitor\\\",\\\"Allen Driscoll, Esq., Driscoll & Frey LLP.\\\"),\\n (\\\"Recalculation (RC-)\\\",\\\"An independent recomputation. See Part 3.\\\"),\\n (\\\"Risk (R-)\\\",\\\"A ranked risk. See Part 5.\\\"),\\n (\\\"Type C buffer\\\",\\\"Type C vegetative screening buffer — native evergreen and deciduous mix achieving at least 75% visual opacity within five years (s.(a) definition; s.(d)).\\\"),\\n]\\nbuild_table(doc, [\\\"Term\\\",\\\"Meaning in this document\\\"], terms, [1.7, 5.1], size=8, hdr_size=8.2, bold_cols=(0,))\\n\\n# ============================================================ APPENDIX C\\nh1(doc, \\\"Appendix C — Review conventions, severity scale and limitations\\\")\\nh2(doc, \\\"Severity (used in Parts 2 and 4)\\\")\\nsev = [\\n (\\\"Critical\\\",\\\"The finding either embeds an Ordinance non-compliance in the approval, contradicts the operative terms of the Decision, or goes to the validity of the approval itself. Requires a Board decision.\\\"),\\n (\\\"High\\\",\\\"A material variance affecting money, area, dates or enforceability, or a requirement of the Ordinance that is absent or relaxed. Requires correction before the relevant permit.\\\"),\\n (\\\"Medium\\\",\\\"An ambiguity that will require clarification before permit or at first compliance measurement, or a delegation or drafting defect with a plausible challenge.\\\"),\\n (\\\"Low\\\",\\\"Clerical or drafting inconsistency with no substantive consequence; correct at the next revision of the record.\\\"),\\n]\\nbuild_table(doc, [\\\"Rating\\\",\\\"Definition\\\"], sev, [0.9, 5.9], size=8, hdr_size=8.2, bold_cols=(0,))\\n\\nh2(doc, \\\"Likelihood and impact (used in Part 5)\\\")\\nli = [\\n (\\\"Likelihood\\\",\\\"High: likely to arise on the current documents. Medium: about even, or contingent on a decision not yet taken. Low: requires an unusual combination of events.\\\"),\\n (\\\"Impact\\\",\\\"High: loss or material impairment of the entitlement, a capital-scale cost, or a life-safety consequence. Medium: delay, dispute, or a moderate financial or political cost. Low: administrative nuisance.\\\"),\\n (\\\"Rating\\\",\\\"The rating shown is the conservative combination of the two, escalated where the exposure is to the validity of the approval rather than to a single transaction.\\\"),\\n]\\nbuild_table(doc, [\\\"Dimension\\\",\\\"Scale\\\"], li, [1.0, 5.8], size=8, hdr_size=8.2, bold_cols=(0,))\\n\\nh2(doc, \\\"Limitations\\\")\\nfor txt in [\\n \\\"**Documentary review only.** No site inspection was undertaken, no permit file was inspected, and no Township officer, consultant or applicant representative was interviewed. Status entries describe what the six documents establish, not what has occurred in fact.\\\",\\n \\\"**The ordinance analysis rests on an excerpt.** Section 27-605(B)(14) was reviewed in an excerpt that disclaims its own controlling effect, is unsigned and undated, and is certified in the name of a different Township Secretary from the officer who attested the Decision. The excerpt also omits s.27-603, s.27-604, s.27-606 and following, and reproduces only subsections (c)(3)-(4) of s.27-605(B)(15). Requirements in the omitted provisions have not been checked. Every gap in Part 4 must be re-tested against the codified text before reliance.\\\",\\n \\\"**Six documents, many referenced but not provided.** The primary evidentiary documents — site plan, noise study, glare analysis, appraisal report, environmental reports, stormwater plans, traffic study, decommissioning plan, PILOT draft and leases — were not in the file. Conclusions about them depend on how the six reviewed documents characterise them, and where two documents characterise the same document differently that difference is itself recorded as an inconsistency.\\\",\\n \\\"**No legal opinion is expressed.** Characterisations of what the Ordinance requires, and of the consequences of a condition departing from it, are analytical. Whether a particular condition is void, severable, or enforceable as written is a question for the Township Solicitor.\\\",\\n \\\"**Third-party citations not verified.** The two authorities cited in Conclusion 3 of the Decision (Bray v. Zoning Board of Adjustment and South Whitehall Township v. City of Allentown) were not checked against the reporters or for the propositions attributed to them; nor were the MPC section citations in the Decision, the county letter and the Solicitor's email reconciled. See I-25 and I-26.\\\",\\n]:\\n    bullet(doc, txt, size=9)\\n\\nh2(doc, \\\"Verification log\\\")\\nvl = [\\n (\\\"S-1\\\",\\\"Decision and Order\\\",\\\"Read in full. All 25 findings, 8 conclusions and 35 conditions extracted and mapped.\\\",\\\"Complete\\\"),\\n (\\\"S-2\\\",\\\"Ordinance excerpt\\\",\\\"Read in full. Requirements indexed by subsection; table and notes transcribed.\\\",\\\"Complete (excerpt only)\\\"),\\n (\\\"S-3\\\",\\\"Applicant letter\\\",\\\"Read in full. Parcel table, accepted-conditions list and figures extracted.\\\",\\\"Complete\\\"),\\n (\\\"S-4\\\",\\\"Planning Commission letter\\\",\\\"Read in full. All recommendations indexed against the conditions.\\\",\\\"Complete\\\"),\\n (\\\"S-5\\\",\\\"Township Engineer email\\\",\\\"Read in full.\\\",\\\"Complete\\\"),\\n (\\\"S-6\\\",\\\"Township Solicitor email\\\",\\\"Read in full; arithmetic and citations checked.\\\",\\\"Complete\\\"),\\n (\\\"RC series\\\",\\\"22 recomputations\\\",\\\"Each performed from the source figures, not from a summary; results reproduced in Part 3.\\\",\\\"Complete\\\"),\\n]\\nbuild_table(doc, [\\\"Source\\\",\\\"Document\\\",\\\"Extent of review\\\",\\\"Status\\\"], vl, [0.7, 1.9, 3.4, 0.8], size=7.8, hdr_size=8, bold_cols=(0,))\\n\\np = doc.add_paragraph(); p.paragraph_format.space_before = Pt(14)\\nr = p.add_run(\\\"End of document.\\\")\\nr.font.size = Pt(8.5); r.italic = True; r.font.color.rgb = GREY\\n\\nout = os.path.join(os.environ.get('OUTPUT_DIR', '.'), 'compliance-tracking-matrix.docx')\\ndoc.save(out)\\nprint(\\\"saved\\\", out)\\nPYEOF\\ncd $WORKSPACE_DIR && python3 build/build_docx.py\"}"}], "input_tokens": 125663, "output_tokens": 4100, "finish_reason": "completed"}
