\\\\n=== 4. WALT independent (anchor 1/1/2025, per rent roll convention, weight=annual rent) ===\\\")\\nexp = {\\\"Apex\\\":date(2029,5,31),\\\"Soto\\\":date(2028,10,31),\\\"BrightPath\\\":date(2032,3,31),\\n       \\\"SEFire\\\":date(2024,6,30),\\\"Verdana\\\":date(2032,6,30),\\\"Pint\\\":date(2030,9,30),\\\"GSA\\\":date(2030,12,31)}\\nanchor=date(2025,1,1)\\ndef walt(gsa_rem=None):\\n    num=0\\n    for k in rent:\\n        r = yrs(anchor,exp[k]) if exp[k]>anchor else 0.0\\n        if k==\\\"GSA\\\" and gsa_rem is not None: r=gsa_rem\\n        num += rent[k]*r\\n    return num/tot\\nprint(\\\"soft-term GSA (to 12/31/2030):\\\", round(walt(),3),\\\" years\\\")\\nprint(\\\"firm-term GSA only (1.0 yr):   \\\", round(walt(1.0),3),\\\" years\\\")\\nprint(\\\"No GSA at all (0):             \\\", round(walt(0.0),3),\\\" years\\\")\\nprint(\\\"rent roll asserts: ~5.7 (soft) / ~4.6 (firm)  -> NOT reproducible\\\")\\n\\nprint(\\\"\\\\n=== 5. At-risk rent analysis ===\\\")\\natrisk = rent.copy()\\nprint(\\\"Aggregate (rent roll):\\\", f\\\"{tot:,.2f}\\\")\\nprint(\\\"SE Fire holdover (terminable on 30 days' notice by either party):\\\", f\\\"{305250:,.2f}\\\", f\\\"({305250/tot*100:.1f}%)\\\")\\nprint(\\\"GSA beyond 12/31/2025 (120-day unilateral termination):\\\", f\\\"{472500:,.2f}\\\", f\\\"({472500/tot*100:.1f}%)\\\")\\nprint(\\\"Soto subject to early-term right (notice by 4/30/2025):\\\", f\\\"{96800:,.2f}\\\", f\\\"({96800/tot*100:.1f}%)\\\")\\nprint(\\\"Apex Yr5 TI-recapture / ROFR exposure: see abstraction\\\")\\nfirm = tot-305250-472500\\nprint(\\\"Contractual firm/stable annual base rent excl. both at-will items:\\\", f\\\"{firm:,.2f}\\\", f\\\"({firm/tot*100:.1f}%)\\\")\\nprint(\\\"Cap rate on aggregate rent / price:\\\", f\\\"{tot/187500000*100:.2f}%\\\",\\\"(rent, not NOI; 7 of 12 properties)\\\")\\n\\nprint(\\\"\\\\n=== 6. Tenant concentration (by annual base rent) ===\\\")\\nfor k,v in sorted(rent.items(), key=lambda x:-x[1]):\\n    print(f\\\"{k:11s} {v:>12,.2f}  {v/tot*100:5.1f}%\\\")\\nprint(\\\"Top 3 tenants:\\\", f\\\"{sum(sorted(rent.values(),reverse=True)[:3])/tot*100:.1f}%\\\")\\nprint(\\\"Top 4 tenants:\\\", f\\\"{sum(sorted(rent.values(),reverse=True)[:4])/tot*100:.1f}%\\\")\\n\\nprint(\\\"\\\\n=== 7. Engagement letter date check ===\\\")\\npsa=date(2024,11,15); dd=date(2024,11,16); de=date(2025,1,31)\\nprint(\\\"PSA -> DD expiry (elapsed days):\\\", (de-psa).days)\\nprint(\\\"DD commencement 11/16 -> 1/31 (elapsed):\\\", (de-dd).days, \\\"; inclusive count:\\\", (de-dd).days+1)\\nprint(\\\"Report due 12/20/2024 -> DD expiry 1/31/2025:\\\", (de-date(2024,12,20)).days, \\\"days =\\\", round((de-date(2024,12,20)).days/7,1),\\\"weeks\\\")\\nprint(\\\"Docs due 12/6/2024; letter dated 12/5/2024 -> 1 day\\\")\\nprint(\\\"Closing 3/15/2025 from DD expiry:\\\", (date(2025,3,15)-de).days,\\\"days\\\")\\nEOF\\npython3 work/verify.py\"}"}], "input_tokens": 117929, "output_tokens": 7580, "finish_reason": "completed"}
