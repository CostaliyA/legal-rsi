pendix B.\\\"],\\n    fill=BOX, size=8.5)\\n\\n# ================= CONTENTS =================\\ndoc.add_page_break()\\nh1(doc, \\\"\\\", \\\"Contents\\\", page_break=False)\\ntoc = [\\n (\\\"1\\\", \\\"Executive Summary\\\", \\\"1.1 Purpose · 1.2 Portfolio at a glance · 1.3 Headline conclusions · 1.4 Rent and rent-at-risk · 1.5 Weighted average remaining term · 1.6 Tenant concentration · 1.7 Expiration profile · 1.8 Priorities for Galleon\\\"),\\n (\\\"2\\\", \\\"Scope, Methodology and Source Inventory\\\", \\\"2.1 Engagement basis · 2.2 Documents reviewed · 2.3 Method · 2.4 Conventions and limitations\\\"),\\n (\\\"3\\\", \\\"Portfolio-Level Analysis\\\", \\\"3.1 Rent-at-risk · 3.2 Encumbrances on leasing and value · 3.3 Operating expense mechanics · 3.4 Credit support · 3.5 Consents, estoppels and SNDAs · 3.6 Option and notice deadlines\\\"),\\n (\\\"4\\\", \\\"Lease Abstractions\\\", \\\"4.1 Apex Fulfillment · 4.2 Dr. Miriam Soto, DDS · 4.3 BrightPath Learning · 4.4 Southeastern Fire & Safety · 4.5 Verdana Software · 4.6 The Pint & Platter · 4.7 United States of America (GSA)\\\"),\\n (\\\"5\\\", \\\"Rent Roll Cross-Check\\\", \\\"5.1 Approach · 5.2 Field-by-field reconciliation · 5.3 Unverified items · 5.4 Rent roll omissions · 5.5 WALT reconciliation · 5.6 Cap rate observation\\\"),\\n (\\\"6\\\", \\\"Independent Verification of Rent Schedules and Dates\\\", \\\"6.1 Method · 6.2 Results by lease · 6.3 Root cause · 6.4 Date and deadline verification\\\"),\\n (\\\"7\\\", \\\"Risk Register\\\", \\\"Prioritised by severity and time-sensitivity, with required action for each item\\\"),\\n (\\\"8\\\", \\\"Recommended Pre-Closing Actions\\\", \\\"Sequenced actions, responsible party and deadline against the January 31, 2025 due diligence expiry\\\"),\\n (\\\"9\\\", \\\"Estoppel and Document Request Checklist\\\", \\\"Required certifications per tenant and ancillary documents to be obtained\\\"),\\n (\\\"10\\\", \\\"Open Items and Information Gaps\\\", \\\"Items that could not be resolved from the documents provided\\\"),\\n (\\\"11\\\", \\\"Limitations and Reliance\\\", \\\"Basis of the Report and matters outside scope\\\"),\\n (\\\"A\\\", \\\"Appendix A — Escalation Schedule Recomputation\\\", \\\"Year-by-year recomputation of each lease's rent schedule\\\"),\\n (\\\"B\\\", \\\"Appendix B — Source Document Index\\\", \\\"Documents reviewed and their identifiers\\\"),\\n (\\\"C\\\", \\\"Appendix C — Abbreviations and Defined Terms\\\", \\\"\\\"),\\n]\\nfor num, title, sub in toc:\\n    p = doc.add_paragraph()\\n    pf = p.paragraph_format\\n    pf.space_before = Pt(7); pf.space_after = Pt(0.5); pf.left_indent = Inches(0.42); pf.first_line_indent = Inches(-0.42)\\n    r = p.add_run(f\\\"{num}.\\\"); r.font.size=Pt(9.5); r.bold=True; r.font.color.rgb = ACCENT; r.font.name=\\\"Calibri\\\"\\n    r = p.add_run(f\\\"   {title}\\\"); r.font.size=Pt(10.5); r.bold=True; r.font.color.rgb = NAVY; r.font.name=\\\"Georgia\\\"\\n    if sub:\\n        p2 = doc.add_paragraph()\\n        pf = p2.paragraph_format\\n        pf.space_before = Pt(0); pf.space_after = Pt(0); pf.left_indent = Inches(0.72)\\n        r = p2.add_run(sub); r.font.size=Pt(8); r.font.color.rgb = GREY; r.font.name=\\\"Calibri\\\"\\n\\ndoc.save(os.path.join(os.getcwd(),'work','partial.docx'))\\nprint(\\\"part1 ok\\\")\\nPYEOF\\npython3 work/build.py\"}", "result": "part1 ok\n"}
